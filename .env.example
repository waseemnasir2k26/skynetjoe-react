# ============================================================
# SkynetLabs site env vars
# Copy to .env.local for dev, set in Vercel dashboard for prod.
# ============================================================

# --- Discovery-call form delivery ---

# GHL Inbound Webhook (primary lead drop)
# Setup: GHL → Automation → Workflows → New Workflow → Trigger: "Inbound Webhook" → copy URL here
GHL_DISCOVERY_WEBHOOK_URL=

# GHL Inbound Webhook (used by /api/leads + /api/webhooks/calendly)
# Single inbound URL that receives both qualified-only and booked leads,
# plus the enriched Calendly webhook payload after invitee.created.
GHL_WEBHOOK_URL=

# Calendly Webhook signature secret (HMAC-SHA256)
# Setup: Calendly → Integrations → Webhooks → Create subscription →
#   URL: https://skynetjoe.com/api/webhooks/calendly
#   Events: invitee.created (optionally invitee.canceled)
#   Signing key: paste the generated secret here. We verify the
#   Calendly-Webhook-Signature header on every request and 401 if invalid.
CALENDLY_WEBHOOK_SECRET=

# Resend (email fallback if GHL down)
# Setup: resend.com → API Keys → create → paste below
RESEND_API_KEY=
RESEND_FROM=leads@skynetjoe.com
LEAD_NOTIFY_EMAIL=waseem@skynetjoe.com

# --- Analytics ---

# Google Tag Manager container (single source — wires GA4 + Pixel inside GTM)
# Setup: tagmanager.google.com → create container → copy GTM-XXXXXX id
NEXT_PUBLIC_GTM_ID=

# Optional direct GA4 (skip if using GTM)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
