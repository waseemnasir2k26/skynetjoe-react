# ============================================================
# SkynetLabs site env vars
# Copy to .env.local for dev, set in host dashboard for prod
# (Vercel / Hostinger Node.js Web App / etc.).
# ============================================================

# ------------------------------------------------------------
# Site URL — used for canonical, sitemap, OG image base,
# robots host, structured data, llms.txt, etc.
# ------------------------------------------------------------

# Apex URL — flip to new domain on cutover (e.g. waseemnasir.com).
# Read in src/lib/site.ts → SITE.url. Required for correct sitemap
# + canonical generation. Defaults to https://skynetjoe.com.
NEXT_PUBLIC_SITE_URL=https://skynetjoe.com

# Apex domain (no scheme). Read in src/lib/site.ts → SITE.domain.
# Used in copy + JSON-LD. Defaults to skynetjoe.com.
NEXT_PUBLIC_SITE_DOMAIN=skynetjoe.com

# Asset host for og:image / twitter:image — see resolveAssetsUrl()
# in src/lib/site.ts. Set this explicitly when the apex domain
# hasn't been cut over yet so social crawlers (Slack, X, LinkedIn)
# can fetch /waseem-portrait.jpg etc. Defaults to the apex SITE.url.
# NEXT_PUBLIC_SITE_ASSETS_URL=https://skynetjoe.com

# ------------------------------------------------------------
# Payload CMS — REQUIRED in prod
# ------------------------------------------------------------

# JWT-signing + admin-session secret. Generate via:
#   openssl rand -hex 32
# Read in payload.config.ts. Falls back to dev-secret-change-me
# locally so dev still boots, but DO NOT ship that to prod.
PAYLOAD_SECRET=

# SQLite db URI. Local dev = file:./payload.db. On Hostinger,
# point at an ABSOLUTE path outside the deploy tree so it
# survives redeploy:
#   DATABASE_URI=file:/home/<user>/data/payload.db
# Read in payload.config.ts.
DATABASE_URI=file:./payload.db

# ------------------------------------------------------------
# GHL (GoHighLevel / LeadConnector) DIRECT REST API
# ------------------------------------------------------------

# Private Integration Token. Required for live contact + opportunity writes.
# Setup: GHL → Settings → Private Integrations → Create →
#   Scopes needed: contacts.write, contacts.readonly,
#                  opportunities.write, opportunities.readonly,
#                  locations.readonly
# If unset, /api/leads + /api/lead-capture + /api/webhooks/calendly silently
# no-op (dev-skip) so local dev doesn't break.
GHL_API_TOKEN=

# Sub-account location id. Default if unset = HSQ2lvxtEpWQUVinspzq
# (Waseem Nasir's account). Set per environment when re-selling the
# stack to another agency's location.
GHL_LOCATION_ID=HSQ2lvxtEpWQUVinspzq

# Sales pipeline id. Default if unset = y1EwUjRMn2UWd9g2paa3.
# Override only when re-selling to a different location with a different pipeline.
GHL_PIPELINE_ID=y1EwUjRMn2UWd9g2paa3

# Legacy discovery-form webhook (still read by /api/discovery as a
# fallback if Resend isn't configured). Safe to leave blank once the
# direct REST integration above is verified in prod.
GHL_DISCOVERY_WEBHOOK_URL=

# ------------------------------------------------------------
# Calendly
# ------------------------------------------------------------

# Webhook signing key (HMAC-SHA256). REQUIRED in prod —
# /api/webhooks/calendly fail-closes (401) without it.
# Setup: Calendly → Integrations → Webhooks → Create subscription →
#   URL: https://<your-domain>/api/webhooks/calendly
#   Events: invitee.created (+ optionally invitee.canceled)
#   Signing key: paste below.
CALENDLY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Email fallback (optional)
# ------------------------------------------------------------

# Resend (used by /api/discovery if no GHL webhook). Setup: resend.com → API Keys.
RESEND_API_KEY=
RESEND_FROM=leads@skynetjoe.com
LEAD_NOTIFY_EMAIL=waseem@skynetjoe.com

# ------------------------------------------------------------
# Tool feedback (optional)
# ------------------------------------------------------------

# Incoming-webhook URL for #tool-feedback Slack channel.
# Setup: Slack → Apps → Incoming Webhooks → Add → pick channel → copy URL.
# When unset, /api/tool-feedback degrades to /tmp logfile only (still 200 OK).
SLACK_FEEDBACK_WEBHOOK=

# ------------------------------------------------------------
# Analytics (optional)
# ------------------------------------------------------------

# Google Tag Manager container (single source — wires GA4 + Pixel inside GTM).
# Setup: tagmanager.google.com → create container → copy GTM-XXXXXX id.
NEXT_PUBLIC_GTM_ID=

# Optional direct GA4 (skip if using GTM)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
