# skynetjoe.com — environment variables
# Set these in Hostinger hPanel (Node app) env. None are committed.
# Routes degrade safely when a var is unset, but lead capture needs at least
# ONE durable sink (GHL_API_TOKEN, SLACK_FEEDBACK_WEBHOOK, or Resend) or it 502s
# instead of silently dropping the lead.

# --- GoHighLevel (primary lead sink) -------------------------------------
# Private Integration Token (pit-...). Required for live GHL contact writes.
# Unset = /api/lead-capture + /api/leads fall back to durable sinks below.
GHL_API_TOKEN=
# Optional overrides (sensible defaults baked into src/lib/ghl.ts):
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
# Inbound-webhook URL used by /api/discovery (legacy hop).
GHL_DISCOVERY_WEBHOOK_URL=

# --- Durable fallback sinks (used when GHL is unavailable) ----------------
# Slack incoming webhook — receives tool-gate leads + tool feedback.
SLACK_FEEDBACK_WEBHOOK=
# Resend email fallback. LEAD_NOTIFY_EMAIL is where lead alerts are sent.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# From-address for Resend (defaults to leads@skynetjoe.com if unset).
RESEND_FROM=

# --- Calendly webhook ------------------------------------------------------
CALENDLY_WEBHOOK_SECRET=
