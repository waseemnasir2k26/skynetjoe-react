# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.claude/worktrees/

# payload cms
/payload.db
/payload.db-journal
/payload.db-wal
/payload.db-shm
/public/media
/src/payload/payload-types.ts
.qa-dev.log

# build/run logs
*.log
.env*.local

# Hostinger deploy source-archive (produced by scripts/deploy-archive.*)
/skynetjoe-deploy.zip

# Captured leads + view counts — runtime data, never commit
.data/
